# ==============================================================================
# CLAMAV-SERVICE CONFIGURATION TEMPLATE
# ==============================================================================

# Server & Network
PORT=8080
HOST=0.0.0.0

# Master Security Encryption Key (Auto-generated on first boot if empty)
ENCRYPTION_KEY=

# API Authorization Policy ("none" | "basic" | "bearer")
# Default: "none" (unrestricted access for internal VPC/network)
AUTH_MODE=none
AUTH_BASIC_USER=admin
AUTH_BASIC_PASS=
AUTH_BEARER_TOKEN=

# Web Admin UI Password Protection (Default: 123456)
UI_PASSWORD=123456

# ClamAV Daemon & Unix Socket
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
CLAMD_CONFIG=/etc/clamav/clamd.conf
FRESHCLAM_CONFIG=/etc/clamav/freshclam.conf

# Persistent Storage & SQLite
DATA_DIR=/data
DB_PATH=/data/clamav-service.db
QUARANTINE_DIR=/data/quarantine

# File Scan Limits & Timeouts
MAX_SCAN_SIZE_MB=100
SCAN_TIMEOUT_SECONDS=30
ARCHIVE_MAX_RECURSION=5
ARCHIVE_MAX_FILES=1000
ARCHIVE_MAX_EXTRACT_MB=250

# Data Retention Policy (Days)
LOG_RETENTION_DAYS=3
QUARANTINE_RETENTION_DAYS=7

# Rate Limiting (Global Server Protection)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_RPS=50
RATE_LIMIT_DEFAULT_RPM_PER_KEY=100
REQUIRE_API_KEY=true

# Multi-Channel Alerting (Optional - Auto-activated when filled)
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

ALERT_DISCORD_ENABLED=false
ALERT_DISCORD_WEBHOOK_URL=

ALERT_SMTP_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_RECIPIENTS=
